{
  "uid": "ollama-main",
  "title": "Ollama LLM Monitoring",
  "description": "Passive monitoring of native Ollama via llama.cpp telemetry in the systemd journal. Clients talk to Ollama directly on :11434; the monitoring stack never sits in the request path. Live values come from llama.cpp slot status lines (tg_3s is the engine's own 3-second decode average); completed values come from the final per-request timing lines and count tokens the engine actually evaluated.",
  "tags": [
    "ollama",
    "llm",
    "gpu"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Live",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Inference state",
      "description": "sum(ollama_slot_active): 1 while a llama.cpp slot is processing, 0 when idle. Slot state comes from the journal (launch/release lines) and is zeroed on release; after a collector restart the series is absent until the next request, which this panel masks to IDLE.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "sum(ollama_slot_active) or on() vector(0)", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [
            { "type": "value", "options": { "0": { "text": "IDLE", "color": "green", "index": 0 } } },
            { "type": "range", "options": { "from": 1, "to": 1000000, "result": { "text": "ACTIVE", "color": "orange", "index": 1 } } },
            { "type": "special", "options": { "match": "null", "result": { "text": "IDLE", "color": "green", "index": 2 } } }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Phase",
      "description": "Current llama.cpp slot sub-phase from the phase gauges: PREFILL (prompt processing), DECODE (token generation), IDLE. Live gauges are zeroed on slot release, so an idle system shows IDLE, never a stale phase.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "(max(ollama_slot_phase_decode or vector(0)) == bool 1) * 2 + (max(ollama_slot_phase_prefill or vector(0)) == bool 1) * 1",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [
            { "type": "value", "options": { "0": { "text": "IDLE", "color": "green", "index": 0 }, "1": { "text": "PREFILL", "color": "yellow", "index": 1 }, "2": { "text": "DECODE", "color": "orange", "index": 2 } } }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Generated so far",
      "description": "Tokens generated in the current/last request (llama.cpp n_gen). Zero when idle.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "max(ollama_live_generated_tokens or vector(0))", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Prompt progress",
      "description": "Prefill progress ratio of the current/last request (llama.cpp progress). Zero when idle.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "max(ollama_live_prompt_progress_ratio or vector(0))", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1, "min": 0, "max": 1 }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Prompt processed / total",
      "description": "Tokens preprocessed so far vs. the logical prompt size (llama.cpp n_tokens and task.n_tokens). task.n_tokens is the submitted prompt including tokens served from cache.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "max(ollama_live_prompt_processed_tokens or vector(0))", "instant": true },
        { "refId": "B", "expr": "max(ollama_live_prompt_total_tokens or vector(0))", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0 },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "B" },
            "properties": [
              { "id": "displayName", "value": "total (submitted)" }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Live decode t/s (tg_3s vs request-average tg)",
      "description": "tg_3s is the engine's own trailing 3-second decode speed (authoritative live value). tg is the request-average decode speed so far. Both are zeroed when the slot is released.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        { "refId": "A", "expr": "max(ollama_live_decode_tokens_per_second_3s or vector(0))", "legendFormat": "tg_3s (last 3s)" },
        { "refId": "B", "expr": "max(ollama_live_decode_tokens_per_second or vector(0))", "legendFormat": "tg (request avg)" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Live prefill t/s and processed tokens",
      "description": "Prompt processing speed from llama.cpp prompt-processing status lines plus the cumulative tokens preprocessed for the current/last request.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        { "refId": "A", "expr": "max(ollama_live_prompt_tokens_per_second or vector(0))", "legendFormat": "prefill t/s" },
        { "refId": "B", "expr": "max(ollama_live_prompt_processed_tokens or vector(0))", "legendFormat": "processed tokens" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "processed tokens" },
            "properties": [
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Completed workload (counted when the engine finishes each request)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Completed evaluated prompt tokens (range)",
      "description": "Prompt tokens the engine actually evaluated (llama.cpp final prompt-eval line). Excludes tokens served from cache - see 'submitted' panel. Requests still in flight are not included yet.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 14 },
      "targets": [
        { "refId": "A", "expr": "sum(increase(ollama_prompt_evaluated_tokens_total[$__range]))", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Completed generated tokens (range)",
      "description": "Generated tokens from llama.cpp final eval lines. Includes reasoning tokens. In-flight requests are not included yet.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 14 },
      "targets": [
        { "refId": "A", "expr": "sum(increase(ollama_generated_tokens_total[$__range]))", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Completed compute tokens (range)",
      "description": "Tokens the engine actually computed: evaluated prompt tokens + generated tokens (llama.cpp 'total time' line). This is what tokens/kWh is based on.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 14 },
      "targets": [
        { "refId": "A", "expr": "sum(increase(ollama_compute_tokens_total[$__range]))", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Completed requests (range)",
      "description": "Requests finalized by the engine (final timing lines). Chat completions and generations; embedding tasks have no final timing and are excluded.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 14 },
      "targets": [
        { "refId": "A", "expr": "sum(increase(ollama_journal_events_matched_total{event=\"final_total\"}[$__range]))", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Submitted prompt tokens, logical (range)",
      "description": "Logical prompt size of all tasks (llama.cpp task.n_tokens), including tokens served from the KV/prompt cache. Larger than 'evaluated' when cache hits skip reprocessing; also includes embedding tasks.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 18 },
      "targets": [
        { "refId": "A", "expr": "sum(increase(ollama_prompt_tokens_submitted_total[$__range]))", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Cache-hit share of prompts (range)",
      "description": "1 - evaluated/submitted: the fraction of submitted prompt tokens that did NOT need evaluation thanks to caching. High share = warm-cache workload.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (sum(increase(ollama_prompt_evaluated_tokens_total[$__range])) / sum(increase(ollama_prompt_tokens_submitted_total[$__range])))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1, "min": 0, "max": 1 }, "overrides": [] }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Completed prompt-eval t/s (per-request)",
      "description": "Distribution of per-request prompt-eval speed from the final llama.cpp timing lines.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 22 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(ollama_prompt_eval_tokens_per_second_bucket[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(ollama_prompt_eval_tokens_per_second_bucket[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "sum(rate(ollama_prompt_eval_tokens_per_second_sum[$__rate_interval])) / sum(rate(ollama_prompt_eval_tokens_per_second_count[$__rate_interval]))", "legendFormat": "avg" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": { "unit": "none", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Completed decode t/s (per-request average)",
      "description": "Distribution of per-request average decode speed from the final llama.cpp eval-time lines (not live tg_3s, and never a counter rate).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 22 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(ollama_decode_tokens_per_second_bucket[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(ollama_decode_tokens_per_second_bucket[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "sum(rate(ollama_decode_tokens_per_second_sum[$__rate_interval])) / sum(rate(ollama_decode_tokens_per_second_count[$__rate_interval]))", "legendFormat": "avg" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": { "unit": "none", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Request duration (GIN access log, passive)",
      "description": "Duration of chat-completion HTTP requests as logged by Ollama itself.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 22 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(ollama_http_request_duration_seconds_bucket{path=~\"/v1/chat/completions|/api/chat\"}[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(ollama_http_request_duration_seconds_bucket{path=~\"/v1/chat/completions|/api/chat\"}[$__rate_interval])))", "legendFormat": "p95" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      }
    },
    {
      "id": 102,
      "type": "row",
      "title": "Efficiency (energy from measured NVIDIA power)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 }
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Completed compute tokens/kWh (range)",
      "description": "Tokens the engine actually evaluated (prompt-eval + generated) divided by measured GPU energy (avg power x range duration, idle time included). Submitted-but-cached prompt tokens are NOT counted as computation.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 31 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ollama_compute_tokens_total[$__range])) / (avg(avg_over_time(nvidia_smi_power_draw_watts[$__range])) * ($__range_s / 3600) / 1000)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Completed evaluated prompt tokens/kWh (range)",
      "description": "Prompt-side compute only. Prompt processing often dominates agentic workloads.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 31 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ollama_prompt_evaluated_tokens_total[$__range])) / (avg(avg_over_time(nvidia_smi_power_draw_watts[$__range])) * ($__range_s / 3600) / 1000)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Completed generated tokens/kWh (range)",
      "description": "Decode-side compute only (includes reasoning tokens). Understates work for prompt-heavy requests; prefer compute tokens/kWh.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 31 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ollama_generated_tokens_total[$__range])) / (avg(avg_over_time(nvidia_smi_power_draw_watts[$__range])) * ($__range_s / 3600) / 1000)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 23,
      "type": "stat",
      "title": "GPU energy over range (kWh)",
      "description": "Measured GPU energy: average power draw x range duration (idle time included).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 31 },
      "targets": [
        { "refId": "A", "expr": "avg(avg_over_time(nvidia_smi_power_draw_watts[$__range])) * ($__range_s / 3600) / 1000", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "kwatth", "decimals": 2 }, "overrides": [] }
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "GPU utilization (%)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 35 },
      "targets": [
        { "refId": "A", "expr": "nvidia_smi_utilization_gpu_ratio * 100", "legendFormat": "RTX 3090" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "GPU VRAM (GiB)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 35 },
      "targets": [
        { "refId": "A", "expr": "nvidia_smi_memory_used_bytes / 1024 / 1024 / 1024", "legendFormat": "used" },
        { "refId": "B", "expr": "nvidia_smi_memory_total_bytes / 1024 / 1024 / 1024", "legendFormat": "total" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": { "unit": "gib", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "GPU power draw (W)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 35 },
      "targets": [
        { "refId": "A", "expr": "nvidia_smi_power_draw_watts", "legendFormat": "power" },
        { "refId": "B", "expr": "nvidia_smi_power_draw_instant_watts", "legendFormat": "instant" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": { "unit": "watt", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      }
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "GPU temperature (°C)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 35 },
      "targets": [
        { "refId": "A", "expr": "nvidia_smi_temperature_gpu", "legendFormat": "temp" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 75 },
                { "color": "red", "value": 85 }
              ]
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 103,
      "type": "row",
      "title": "Prompt cache",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 }
    },
    {
      "id": 40,
      "type": "stat",
      "title": "Cache size (GiB)",
      "description": "llama.cpp prompt cache footprint (cache state lines).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 44 },
      "targets": [
        { "refId": "A", "expr": "max(ollama_prompt_cache_bytes or vector(0)) / 1073741824", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "gib", "decimals": 2 }, "overrides": [] }
    },
    {
      "id": 41,
      "type": "stat",
      "title": "Cache entries",
      "description": "Number of prompts held in the llama.cpp prompt cache.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 44 },
      "targets": [
        { "refId": "A", "expr": "max(ollama_prompt_cache_entries or vector(0))", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 42,
      "type": "stat",
      "title": "Full reprocessing events (range)",
      "description": "Times the engine forced full prompt re-processing due to lack of cache data (cold cache or SWA/hybrid models).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 44 },
      "targets": [
        { "refId": "A", "expr": "sum(increase(ollama_prompt_cache_full_reprocess_total[$__range]))", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 43,
      "type": "stat",
      "title": "Cache evictions (range)",
      "description": "Oldest-entry removals from the prompt cache when making room.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 44 },
      "targets": [
        { "refId": "A", "expr": "sum(increase(ollama_prompt_cache_evictions_total[$__range]))", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 44,
      "type": "timeseries",
      "title": "Cache update latency (s)",
      "description": "Time llama.cpp took to update/restore the prompt cache (p90 and average). Spikes show warm-context restore cost that the proxy architecture could never see.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 48 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.90, sum by (le) (rate(ollama_prompt_cache_update_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p90" },
        { "refId": "B", "expr": "sum(rate(ollama_prompt_cache_update_duration_seconds_sum[$__rate_interval])) / sum(rate(ollama_prompt_cache_update_duration_seconds_count[$__rate_interval]))", "legendFormat": "avg" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      }
    },
    {
      "id": 45,
      "type": "timeseries",
      "title": "Cache size over time (MiB)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 48 },
      "targets": [
        { "refId": "A", "expr": "max(ollama_prompt_cache_bytes or vector(0)) / 1048576", "legendFormat": "cache size" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": { "unit": "mbytes", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": []
      }
    },
    {
      "id": 104,
      "type": "row",
      "title": "Collector health (self-observability)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 56 }
    },
    {
      "id": 50,
      "type": "timeseries",
      "title": "Journal ingest & parser match rate",
      "description": "Lines read from the ollama.service journal and telemetry events matched by the parser. A large unmatched share after an Ollama upgrade usually means the llama.cpp log format changed.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 57 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(ollama_journal_lines_seen_total[$__rate_interval]))", "legendFormat": "lines seen" },
        { "refId": "B", "expr": "sum(rate(ollama_journal_events_matched_total[$__rate_interval]))", "legendFormat": "events matched" },
        { "refId": "C", "expr": "sum(rate(ollama_journal_lines_seen_total[$__rate_interval])) - sum(rate(ollama_journal_events_matched_total[$__rate_interval]))", "legendFormat": "unmatched" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": { "unit": "ops", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 5, "showPoints": "never" } },
        "overrides": []
      }
    },
    {
      "id": 51,
      "type": "stat",
      "title": "Last relevant event age",
      "description": "Seconds since the last parsed llama.cpp telemetry event. Large values while a request is running indicate collector/journal problems; large values on an idle system are normal.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 57 },
      "targets": [
        { "refId": "A", "expr": "time() - max(ollama_journal_last_event_timestamp_seconds or vector(0))", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3600 },
              { "color": "red", "value": 86400 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 52,
      "type": "stat",
      "title": "HTTP requests by path (rate)",
      "description": "Passive request counts derived from Ollama's GIN access-log lines.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 57 },
      "targets": [
        { "refId": "A", "expr": "sum by (path) (rate(ollama_http_requests_total[5m]))", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] }
    },
    {
      "id": 53,
      "type": "timeseries",
      "title": "Parsed events by type (rate)",
      "description": "Per-category rate of parsed journal events (lifecycle, timings, cache, http).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 61 },
      "targets": [
        { "refId": "A", "expr": "sum by (event) (rate(ollama_journal_events_matched_total[$__rate_interval]))", "legendFormat": "{{event}}" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": { "unit": "ops", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 5, "showPoints": "never" } },
        "overrides": []
      }
    },
    {
      "id": 54,
      "type": "stat",
      "title": "Collector target up",
      "description": "Prometheus scrape health of the journal collector.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 61 },
      "targets": [
        { "refId": "A", "expr": "up{job=\"journal-metrics\"}", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green", "index": 0 }, "0": { "text": "DOWN", "color": "red", "index": 1 } } }
          ]
        },
        "overrides": []
      }
    }
  ]
}
