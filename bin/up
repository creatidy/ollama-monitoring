#!/usr/bin/env bash
# Start the monitoring stack. Monitoring is passive: nothing here touches
# Ollama, discovers WSL IPs, or proxies inference traffic.
set -euo pipefail
cd "$(dirname "$0")/.." || exit
# shellcheck source=bin/common.sh
source bin/common.sh

if ! command -v docker >/dev/null 2>&1; then
  echo "ERROR: docker not found. Run ./bin/doctor for diagnostics." >&2
  exit 1
fi
if ! docker compose version >/dev/null 2>&1; then
  echo "ERROR: Docker Compose is unavailable. Run ./bin/doctor for diagnostics." >&2
  exit 1
fi

if [[ -L .env ]]; then
  echo "ERROR: .env must not be a symbolic link." >&2
  exit 1
elif [[ -e .env && ! -f .env ]]; then
  echo "ERROR: .env exists but is not a regular file." >&2
  exit 1
elif [[ ! -e .env ]]; then
  umask 077
  if command -v openssl >/dev/null 2>&1; then
    GRAFANA_PASSWORD="$(openssl rand -hex 24)"
  else
    GRAFANA_PASSWORD="$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n')"
  fi
  if [[ -z "${GRAFANA_PASSWORD}" ]]; then
    echo "ERROR: could not generate a Grafana password. Set GRAFANA_ADMIN_PASSWORD manually." >&2
    exit 1
  fi
  {
    printf '# Generated by ./bin/up; keep this file private.\n'
    printf 'GRAFANA_ADMIN_USER=admin\n'
    printf 'GRAFANA_ADMIN_PASSWORD=%s\n' "${GRAFANA_PASSWORD}"
  } > .env
  echo "Created .env with a random Grafana password (read it from .env)."
fi

# Resolve all host-specific Compose values before Docker sees the file. A
# missing journal path is an error here rather than a bind-mount side effect.
if ! resolve_runtime_values 1; then
  echo "ERROR: could not resolve an existing readable journal source or numeric" >&2
  echo "       collector/journal group. Set explicit overrides if needed, or run" >&2
  echo "       ./bin/doctor for diagnostics." >&2
  exit 1
fi

# The cursor directory is intentionally ignored by git. Create it as the host
# user so the non-root collector can persist its checkpoint on a fresh clone.
mkdir -p data/vector
if [[ ! -w data/vector ]]; then
  echo "ERROR: data/vector is not writable by uid ${COLLECTOR_UID}. Run ./bin/doctor." >&2
  exit 1
fi

echo "Using journal source ${JOURNAL_DIR} (collector ${COLLECTOR_UID}:${COLLECTOR_GID}, journal gid ${JOURNAL_GID})."
if [[ ! -f /etc/machine-id ]]; then
  echo "ERROR: /etc/machine-id is missing. Run ./bin/doctor." >&2
  exit 1
fi
if ! journalctl -u ollama -n 1 --no-pager >/dev/null 2>&1; then
  echo "INFO: current user cannot read ollama.service directly; checking the" >&2
  echo "      container group mapping instead." >&2
fi
if ! collector_journal_probe; then
  echo "WARNING: collector journal permission probe did not succeed. The stack" >&2
  echo "         may start without ingesting events; run ./bin/doctor." >&2
fi

GPU_MODE="${OLLAMA_MONITORING_GPU:-auto}"
case "${GPU_MODE}" in
  auto|nvidia|none) ;;
  *)
    echo "ERROR: OLLAMA_MONITORING_GPU must be auto, nvidia, or none (got ${GPU_MODE})." >&2
    exit 1
    ;;
esac

GPU_ENABLED=0
if [[ "${GPU_MODE}" != "none" ]] && docker_gpu_accessible missing; then
  GPU_ENABLED=1
fi
if [[ "${GPU_MODE}" == "nvidia" && "${GPU_ENABLED}" -ne 1 ]]; then
  echo "ERROR: NVIDIA was explicitly requested but Docker GPU access failed." >&2
  echo "       Run ./bin/doctor or use OLLAMA_MONITORING_GPU=none." >&2
  exit 1
fi
if [[ "${GPU_ENABLED}" -eq 1 ]]; then
  export COMPOSE_PROFILES=nvidia
  echo "NVIDIA profile enabled."
else
  export COMPOSE_PROFILES=""
  if [[ "${GPU_MODE}" == "auto" ]]; then
    echo "INFO: NVIDIA profile disabled; starting core journal monitoring without GPU metrics."
  else
    echo "NVIDIA profile disabled by OLLAMA_MONITORING_GPU=none."
  fi
fi

# Compose does not consider an inactive profiled service an orphan. Remove a
# previously enabled exporter explicitly when the selected mode is core-only.
if [[ "${GPU_ENABLED}" -eq 0 ]]; then
  docker compose --profile nvidia rm --stop --force nvidia-gpu-exporter >/dev/null 2>&1 || true
fi

if ! docker compose up -d --remove-orphans; then
  echo "ERROR: Docker could not start the stack. Run ./bin/doctor and inspect" >&2
  echo "       docker compose logs for the failing service." >&2
  exit 1
fi

# journal-metrics and prometheus consume bind-mounted config files. A file's
# inode can be replaced by edits, and an existing container would keep the
# stale mount, so always recreate the two config consumers.
if ! docker compose up -d --force-recreate --remove-orphans journal-metrics prometheus; then
  echo "ERROR: collector/Prometheus recreation failed. Run ./bin/doctor." >&2
  exit 1
fi

# Wait until every user-facing core service is healthy. The optional NVIDIA
# exporter has no healthcheck and is intentionally not part of this gate.
echo "Waiting for services to become healthy..."
core_services_healthy() {
  local statuses service
  local core_services=(journal-metrics prometheus grafana)
  statuses="$(docker compose ps --format '{{.Service}}\t{{.Health}}' 2>/dev/null || true)"
  for service in "${core_services[@]}"; do
    if ! printf '%s\n' "${statuses}" | grep -Eq "^${service}[[:space:]]+healthy$"; then
      return 1
    fi
  done
  return 0
}
for _ in $(seq 1 60); do
  if core_services_healthy; then
    echo
    echo "Stack is up:"
    docker compose ps --format 'table {{.Name}}\t{{.Service}}\t{{.Status}}'
    echo
    echo "  Grafana    : http://localhost:3000  (login: see .env)"
    echo "  Prometheus : http://localhost:9090"
    echo "  Collector  : http://localhost:9598/metrics"
    echo "  Ollama     : native on :${OLLAMA_PORT} (not part of this stack)"
    exit 0
  fi
  sleep 2
done

echo "WARNING: core services did not all become healthy in time:" >&2
docker compose ps >&2
docker compose logs --tail 30 >&2
echo "Run ./bin/doctor, then inspect docker compose logs." >&2
exit 1
