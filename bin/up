#!/usr/bin/env bash
# Start the monitoring stack (journal collector, Prometheus, Grafana, GPU
# exporter). Monitoring is passive: nothing here touches Ollama, discovers
# WSL IPs, or proxies inference traffic.
set -euo pipefail
cd "$(dirname "$0")/.."

if ! command -v docker >/dev/null 2>&1; then
  echo "ERROR: docker not found" >&2
  exit 1
fi

if [[ ! -f .env ]]; then
  cp .env.example .env
fi

# The cursor directory is intentionally ignored by git. Create it as the WSL
# user so the non-root collector can persist its checkpoint on a fresh clone.
mkdir -p data/vector

# Sanity: the journal collector must be able to read the host journal. This is
# a read-only check of the paths mounted into the collector container.
for p in /var/log/journal /run/log/journal /etc/machine-id; do
  if [[ ! -e "$p" ]]; then
    echo "WARNING: $p does not exist on the host; the collector may find no journal." >&2
  fi
done
if ! journalctl -u ollama -n 1 --no-pager >/dev/null 2>&1; then
  echo "WARNING: current user cannot read the ollama journal; inside the" >&2
  echo "container the systemd-journal group (group_add in compose.yaml) is" >&2
  echo "what grants access - verify with: ./bin/status" >&2
fi

docker compose up -d --remove-orphans

# journal-metrics and prometheus consume bind-mounted config files. A file's
# inode can be replaced by edits, and an existing container would keep the
# stale mount, so always recreate the two config consumers.
docker compose up -d --force-recreate --remove-orphans journal-metrics prometheus

# Wait for readiness via healthchecks.
echo "Waiting for services to become healthy..."
for _ in $(seq 1 60); do
  HEALTHY="$(docker compose ps --format '{{.Health}}' 2>/dev/null | grep -c '^healthy$' || true)"
  UNHEALTHY="$(docker compose ps --format '{{.Health}}' 2>/dev/null | grep -c '^unhealthy$' || true)"
  if [[ "${HEALTHY}" -ge 2 && "${UNHEALTHY}" -eq 0 ]]; then
    echo
    echo "Stack is up:"
    docker compose ps --format 'table {{.Name}}\t{{.Service}}\t{{.Status}}'
    echo
    echo "  Grafana    : http://localhost:3000  (login: see .env)"
    echo "  Prometheus : http://localhost:9090"
    echo "  Collector  : http://localhost:9598/metrics"
    echo "  Ollama     : native on :11434 (not part of this stack)"
    exit 0
  fi
  sleep 2
done

echo "WARNING: some services did not turn healthy in time:" >&2
docker compose ps >&2
docker compose logs --tail 30 >&2
exit 1
