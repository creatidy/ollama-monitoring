#!/usr/bin/env bash
# Overview of the monitoring stack: container health, endpoints, native
# Ollama reachability, Prometheus scrape targets, journal collector liveness.
set -uo pipefail
cd "$(dirname "$0")/.." || exit
# shellcheck source=bin/common.sh
source bin/common.sh
resolve_runtime_values 0 || true

fail=0
ok()   { printf '  [ OK ] %s\n' "$1"; }
warn() { printf '  [WARN] %s\n' "$1"; }
bad()  { printf '  [FAIL] %s\n' "$1"; fail=1; }

echo "=== Containers ==="
docker compose ps --format 'table {{.Name}}\t{{.Service}}\t{{.Status}}\t{{.Health}}' 2>/dev/null || bad "docker compose ps failed"

echo
echo "=== Native Ollama (direct, not part of this stack) ==="
if curl -sf -m 3 "http://127.0.0.1:${OLLAMA_PORT}/api/version" >/dev/null 2>&1; then
  VERSION="$(ollama_version)"
  ok "native Ollama on :${OLLAMA_PORT} (version ${VERSION:-unknown})"
  MODEL_COUNT="$(ollama_model_count)"
  if [[ -n "${MODEL_COUNT}" && "${MODEL_COUNT}" -gt 1 ]]; then
    warn "Multiple loaded models detected. Journal timing metrics are not model-labelled and may be aggregated."
  elif [[ "${MODEL_COUNT}" == "1" ]]; then
    ok "one Ollama model runner loaded (journal attribution is unambiguous in practice)"
  elif [[ "${MODEL_COUNT}" == "0" ]]; then
    warn "no Ollama model runner currently loaded"
  fi
else
  warn "native Ollama not reachable on :${OLLAMA_PORT} (monitoring still works; clients need it)"
fi

echo
echo "=== Endpoints ==="
if curl -sf -m 3 http://127.0.0.1:9598/metrics >/dev/null; then
  ok "journal collector  : http://localhost:9598/metrics"
else
  bad "journal collector on :9598 not responding"
fi
if curl -sf -m 3 http://127.0.0.1:9090/-/healthy >/dev/null; then
  ok "Prometheus         : http://localhost:9090"
else
  bad "Prometheus on :9090 not responding"
fi
if curl -sf -m 3 http://127.0.0.1:3000/api/health >/dev/null; then
  ok "Grafana            : http://localhost:3000 ($(curl -sf -m 3 http://127.0.0.1:3000/api/health | grep -o '"database": *"[^"]*"'))"
else
  bad "Grafana on :3000 not responding"
fi

echo
echo "=== Journal collector self-observability ==="
M="$(curl -sf -m 5 http://127.0.0.1:9598/metrics 2>/dev/null)"
if [[ -z "${M}" ]]; then
  bad "cannot read collector metrics"
else
  SEEN="$(printf '%s' "${M}" | grep -E '^ollama_journal_lines_seen_total' | awk '{print $2}' | tail -1)"
  LAST="$(printf '%s' "${M}" | grep -E '^ollama_journal_last_event_timestamp_seconds' | awk '{print $2}' | tail -1)"
  MATCHED="$(printf '%s' "${M}" | grep -cE '^ollama_journal_events_matched_total\{.*\} [0-9]')"
  if python3 -c "exit(0 if float('${SEEN:-0}') > 0 else 1)" 2>/dev/null; then
    ok "journal lines seen: ${SEEN%.*}"
  else
    bad "collector has not seen any journal lines"
  fi
  if [[ "${MATCHED}" -gt 0 ]]; then
    ok "telemetry events matched: ${MATCHED} event series"
  else
    warn "no llama.cpp telemetry matched (parser/log-format mismatch?)"
  fi
  if [[ -n "${LAST}" ]] && python3 -c "import time; exit(0 if time.time() - float('${LAST}') < 600 else 1)" 2>/dev/null; then
    ok "last relevant event: $(date -d "@${LAST%.*}" '+%H:%M:%S') (recent)"
  else
    warn "no relevant llama.cpp event in the last 10 minutes (idle system?)"
  fi
fi

echo
echo "=== Prometheus scrape targets ==="
TARGETS="$(curl -sf -m 5 'http://127.0.0.1:9090/api/v1/targets?state=active' 2>/dev/null)"
if [[ -z "${TARGETS}" ]]; then
  bad "cannot reach Prometheus API"
else
  TARGETS_RENDERED="$(echo "${TARGETS}" | python3 -c '
import json,sys
d = json.load(sys.stdin)
for t in d["data"]["activeTargets"]:
    status = t["health"]
    job = t["labels"].get("job", "?")
    label = f"{job} ({t['"'"'scrapeUrl'"'"']})"
    err = t.get("lastError","")
    if status == "up":
        marker = " OK "
    elif job == "nvidia-gpu":
        marker = "WARN"
        err = (err + "; " if err else "") + "optional; enable with OLLAMA_MONITORING_GPU=nvidia"
    else:
        marker = "FAIL"
    line = f"{status.upper():8s} {label}"
    if err: line += f"  lastError={err}"
    print(f"  [{marker}] {line}")
')"
  if [[ -n "${TARGETS_RENDERED}" ]]; then
    printf '%s\n' "${TARGETS_RENDERED}"
    if printf '%s\n' "${TARGETS_RENDERED}" | grep -q '\[FAIL\]'; then
      fail=1
    fi
  else
    bad "could not parse targets"
  fi
fi

echo
if [[ ${fail} -eq 0 ]]; then
  echo "Status: all good."
else
  echo "Status: problems detected (see above). Run ./bin/doctor, then ./bin/up to heal."
fi
exit ${fail}
