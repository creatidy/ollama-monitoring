# This file documents the values accepted by Compose. Do not use this file as
# a public password. ./bin/up creates .env with a random password automatically
# and never overwrites an existing .env.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-random-local-password

# Optional runtime overrides. ./bin/up detects these automatically.
# COLLECTOR_UID=
# COLLECTOR_GID=
# JOURNAL_GID=
# JOURNAL_DIR=
# OLLAMA_MONITORING_GPU=auto
